<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.bsmi</groupId>
  <artifactId>AttendanceSystem</artifactId>
  <version>1.0-SNAPSHOT</version>
  <name>Attendance System</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <ikonli.version>12.4.0</ikonli.version>
    <!-- Filled in by JaCoCo; empty when the tests run without it, e.g. from an IDE -->
    <argLine></argLine>
    <!-- Installers need a plain number version; the release workflow sets it from the tag -->
    <dist.version>1.0.0</dist.version>
    <!-- APP_IMAGE (a folder with the app and its own Java), DEB, RPM, MSI, EXE, DMG or PKG -->
    <dist.type>APP_IMAGE</dist.type>
    <!-- Menu entry and desktop shortcut; only installers (not APP_IMAGE) can add them -->
    <dist.shortcuts>false</dist.shortcuts>
    <!-- Extra packages a .deb installs with the app; JavaFX draws its windows with GTK -->
    <dist.linux-deps></dist.linux-deps>
    <jlink.executable>${java.home}/bin/jlink</jlink.executable>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.5.252</version>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
      <version>13.11.1</version>
    </dependency>
    <dependency>
      <groupId>org.mindrot</groupId>
      <artifactId>jbcrypt</artifactId>
      <version>0.4</version>
    </dependency>
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>3.5.4</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>27.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>27.0.1</version>
    </dependency>
    <dependency>
      <groupId>io.github.palexdev</groupId>
      <artifactId>materialfx</artifactId>
      <version>11.17.0</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-core</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-fontawesome5-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-fontawesome-pack</artifactId>
      <version>${ikonli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.7</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testfx</groupId>
      <artifactId>testfx-junit5</artifactId>
      <version>4.0.18</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-build-tools</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>AttendanceSystem needs JDK 25 or newer (https://adoptium.net/).</message>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                  <message>Use the bundled wrapper: ./mvnw (Windows: mvnw.cmd).</message>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <release>25</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <!-- TestFX sets up the JavaFX toolkit through these internal classes -->
          <argLine>@{argLine}
            --add-exports javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
            --add-opens javafx.graphics/com.sun.javafx.application=ALL-UNNAMED
            --enable-native-access=javafx.graphics</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <executions>
          <execution>
            <id>record-coverage</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <!-- target/site/jacoco/index.html -->
            <id>coverage-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-gate</id>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <!-- The screens are covered by the UI tests, which a machine without a display
                     skips, so only the logic below them is gated -->
                <rule>
                  <element>PACKAGE</element>
                  <includes>
                    <include>com.bsmi.attendancesystem.dao</include>
                    <include>com.bsmi.attendancesystem.service</include>
                  </includes>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <executions>
          <execution>
            <!-- Default configuration for running with: mvn clean javafx:run -->
            <id>default-cli</id>
            <configuration>
              <mainClass>com.bsmi.attendancesystem/com.bsmi.attendancesystem.AttendanceApplication</mainClass>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <!-- ./mvnw versions:display-dependency-updates lists newer stable releases -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>versions-maven-plugin</artifactId>
        <version>2.23.0</version>
        <configuration>
          <ruleSet>
            <ignoreVersions>
              <ignoreVersion>
                <type>regex</type>
                <version>(?i).*-(alpha|beta|rc|m|ea|cr)[-.]?\d*.*</version>
              </ignoreVersion>
            </ignoreVersions>
          </ruleSet>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <!-- ./mvnw -Pdist package: the app with its own Java runtime in target/dist -->
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.11.0</version>
            <executions>
              <execution>
                <id>copy-libraries</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <outputDirectory>${project.build.directory}/libs</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <!-- jlink refuses to write into an existing folder -->
                <id>remove-old-runtime</id>
                <phase>package</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${project.build.directory}/runtime</directory>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.6.4</version>
            <executions>
              <execution>
                <!-- H2, Flyway and jbcrypt aren't real modules, and jlink refuses those, so the
                     runtime holds only the JDK modules; everything else goes next to it -->
                <id>java-runtime</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${jlink.executable}</executable>
                  <arguments>
                    <argument>--add-modules</argument>
                    <!-- The modules jdeps reports the libraries in target/libs need -->
                    <argument>java.base,java.compiler,java.desktop,java.instrument,java.management,java.naming,java.prefs,java.scripting,java.sql,jdk.jfr,jdk.net,jdk.unsupported</argument>
                    <argument>--strip-debug</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--no-header-files</argument>
                    <argument>--output</argument>
                    <argument>${project.build.directory}/runtime</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.panteleyev</groupId>
            <artifactId>jpackage-maven-plugin</artifactId>
            <version>1.8.0</version>
            <executions>
              <execution>
                <id>package-app</id>
                <phase>package</phase>
                <goals>
                  <goal>jpackage</goal>
                </goals>
                <configuration>
                  <name>AttendanceSystem</name>
                  <appVersion>${dist.version}</appVersion>
                  <vendor>BSMI</vendor>
                  <type>${dist.type}</type>
                  <runtimeImage>${project.build.directory}/runtime</runtimeImage>
                  <modulePaths>
                    <modulePath>${project.build.directory}/libs</modulePath>
                  </modulePaths>
                  <module>com.bsmi.attendancesystem/com.bsmi.attendancesystem.AttendanceApplication</module>
                  <javaOptions>
                    <option>--enable-native-access=javafx.graphics</option>
                  </javaOptions>
                  <destination>${project.build.directory}/dist</destination>
                  <removeDestination>true</removeDestination>
                  <linuxShortcut>${dist.shortcuts}</linuxShortcut>
                  <linuxPackageDeps>${dist.linux-deps}</linuxPackageDeps>
                  <winMenu>${dist.shortcuts}</winMenu>
                  <winShortcut>${dist.shortcuts}</winShortcut>
                  <winDirChooser>${dist.shortcuts}</winDirChooser>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>windows-jlink</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <jlink.executable>${java.home}/bin/jlink.exe</jlink.executable>
      </properties>
    </profile>
  </profiles>
</project>